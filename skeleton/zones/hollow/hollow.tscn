; MC 10519 S27 hollow visual identity — the declared default from
; .tmp/w5-proposal-v0.md (dark-graded, ruins-adjacent): a spectral teal-silver
; night basin, denser fog than the open zones, glow held BELOW meadow's 0.4
; (darkness is identity, the S15/Ruins precedent — the cycle never brightens
; it). Noon sits ON the DayNightClock Hollow table's noon row (the S15
; "noon == shipped tscn values" convention; ZONE4_ANCHOR + the ZONE_VISUAL_
; MOUNT driver markers prove the live reads). Fog is the plain (volumetric-
; exempt) environment fog — GL Compatibility has no volumetric pass — and
; fog_sky_affect stays pinned 0.0 (S13 sky-wash guard, re-pinned by the
; driver every frame). D-1 REUSE-ONLY: zero new art; identity is grade + kit.
fog_enabled = true
fog_light_color = Color(0.5, 0.62, 0.6, 1)
fog_light_energy = 0.45
fog_density = 0.007
fog_sky_affect = 0.0
adjust_enabled = true
adjust_contrast = 1.30
adjust_saturation = 0.72
glow_enabled = true
glow_strength = 0.3
glow_bloom = 0.12
adjustment_enabled = true
adjustment_contrast = 1.1
adjustment_saturation = 1.05

