<Project Sdk="Microsoft.NET.Sdk">
  <!-- Last Animal — skill-core test project (MC 3912 stage 2e, code,
       2026-10-02). Standalone xunit project: compiles the engine-free
       src/dna + src/skills + src/combat + src/save sources the skill core
       rides, so `dotnet test` runs the PlayerMutations/SkillState suite
       headless without the Godot SDK — the exact shape of
       tests/quest/LastAnimalQuestTests.csproj. The engine project compiles
       the same files for the live scene. Deliberately NO src/story files:
       the skill gate shares no source with the concurrent 2d sibling. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Assembly name must not collide with the Godot project's assembly. -->
    <AssemblyName>LastAnimalSkillTests</AssemblyName>
    <RootNamespace>LastAnimal.Tests</RootNamespace>
    <!-- Compile ONLY the explicitly listed files below (same rule as every
         per-feature test csproj: explicit list is the source of truth). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skill core + the pure sources it reads (engine-free I3). The Godot-
         side SaveLoadController/WorldDirector are NOT compiled here; the
         round-trip tests ride the REAL SaveSystem over TempDirSaveStore. -->
    <Compile Include="../../src/dna/LanguageSignature.cs" />
    <Compile Include="../../src/dna/DnaMessage.cs" />
    <Compile Include="../../src/dna/DnaLanguage.cs" />
    <Compile Include="../../src/dna/EcosystemAdaptation.cs" />
    <Compile Include="../../src/dna/PlayerMutations.cs" />
    <Compile Include="../../src/skills/SkillState.cs" />
    <Compile Include="../../src/combat/CombatVec3.cs" />
    <Compile Include="../../src/combat/PlayerController.cs" />
    <Compile Include="../../src/save/GameState.cs" />
    <Compile Include="../../src/save/SaveSystem.cs" />
    <!-- The test files themselves (EnableDefaultCompileItems=false, so they
         must be listed). The harness self-test is compiled conditionally so
         the gate script can drop it with /p:IncludeHarness=false (two-sided
         calibration, same pattern as ci/quest_test.sh). -->
    <Compile Include="PlayerMutationsTests.cs" />
    <Compile Include="SkillEconomyTests.cs" />
    <Compile Include="SkillSaveRoundtripTests.cs" />
    <!-- MC 10200 S16: the resonance-passive rows (derivation table pinned to
         the ONE S16 tuning block + the two shipped write seams). -->
    <Compile Include="ResonancePassiveTests.cs" />
    <Compile Include="SkillHarnessSelfTest.cs" Condition=" '$(IncludeHarness)' != 'false' " />
  </ItemGroup>

</Project>
