<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- EXACT version pin (no 4.7.*, no 'latest'): this SDK must stay equal to the
       engine build in ../engine/PIN.txt (4.7.2-stable). NuGet resolves this
       from the offline feed in NuGet.Config, so the SDK version cannot drift
       past what the pinned editor ships. Bump both together, never one alone. -->

  <PropertyGroup>
    <!-- Assembly name must match [dotnet] project/assembly_name in project.godot. -->
    <AssemblyName>LastAnimalPreflight</AssemblyName>
    <RootNamespace>LastAnimal</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Exclude the xunit test files: they are compiled by the standalone
         test project (tests/LastAnimalDnaNpcTests.csproj), not by the
         Godot project. The Godot project compiles the src/ files + the
         Godot-specific test scripts (BootTest.cs). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the M02/M03 source files (pure logic, no Godot dependency). -->
    <Compile Include="src/dna/DnaLanguage.cs" />
    <Compile Include="src/dna/DnaMessage.cs" />
    <Compile Include="src/dna/LanguageSignature.cs" />
    <Compile Include="src/dna/EcosystemAdaptation.cs" />
    <Compile Include="src/npc/SalarySystem.cs" />
    <Compile Include="src/npc/BetrayalSystem.cs" />
    <Compile Include="src/npc/CompanionComponent.cs" />
    <Compile Include="src/npc/EmotionalDepth.cs" />
    <!-- Compile M05 companion-system sources (pure logic + Godot entity seam). -->
    <Compile Include="src/companion/CompanionStateMachine.cs" />
    <Compile Include="src/companion/CompanionNeeds.cs" />
    <Compile Include="src/companion/CompanionAnimationHook.cs" />
    <Compile Include="src/companion/CompanionEntity.cs" />
    <!-- Compile MC 3943 stage 2g roster source (the pure follower roster:
         cap 3, unique bus keys, the roster-mean-last emit-order contract). -->
    <Compile Include="src/companion/CompanionRoster.cs" />
    <!-- Compile M04 empathy-book pure-logic source. -->
    <Compile Include="src/empathy/EmpathyBook.cs" />
    <!-- Compile M10 ui-hud source (C13: Hud, DialogueSystem, EmpathyPanel). -->
    <Compile Include="src/ui/Hud.cs" />
    <Compile Include="src/ui/DialogueSystem.cs" />
    <Compile Include="src/ui/EmpathyPanel.cs" />
    <!-- Compile MC 3900 stage 2a story data layer (DialogueTable: pure logic,
         the injected text source of the dialogue view) + its headless
         exact-text capture proof (Godot SceneTree script, ci/ui_test.sh leg D). -->
    <Compile Include="src/story/DialogueTable.cs" />
    <Compile Include="tests/story/StoryTextCaptureTest.cs" />
    <!-- Compile MC 3904 stage 2c quest core (pure QuestTable/QuestLog, the
         DialogueTable shape discipline) + the story/quest composition-root
         partial + the quest-arc runtime proof partial. -->
    <Compile Include="src/story/QuestTable.cs" />
    <Compile Include="src/story/QuestLog.cs" />
    <Compile Include="world/WorldDirector.Story.cs" />
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Quests.cs" />
    <!-- Compile MC 3912 stage 2e skill core (PlayerMutations unlock authority
         + engine-free SkillState economy, the skill composition partial and
         the skill runtime-proof partial). -->
    <Compile Include="src/dna/PlayerMutations.cs" />
    <Compile Include="src/skills/SkillState.cs" />
    <Compile Include="world/WorldDirector.Skills.cs" />
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Skills.cs" />
    <!-- Compile MC 10031 Calming Speak: the calm-window runtime-proof partial
         (skill→recruitment bridge; the code lives in the 2e files above). -->
    <Compile Include="ci_proofs/RuntimeIntegrationProof.CalmingSpeak.cs" />
    <!-- Compile MC 10098 Inc-3 S0: the bus-emit proof partial (mode bus_emit)
         + the positive-chain stages 1-4 moved VERBATIM out of the main proof
         harness so it stays under the 600-line ceiling (split duty). -->
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Bus.cs" />
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Chain.cs" />
    <!-- Compile MC 3933 stage 2f skills/quest UI (the TAB-toggle SkillsPanel
         view + the UI composition partial + its headless pure-logic leg +
         the framebuffer capture script for ci/ui_test.sh legs E/F). -->
    <Compile Include="src/ui/SkillsPanel.cs" />
    <Compile Include="world/WorldDirector.Ui.cs" />
    <Compile Include="tests/ui/SkillsPanelTest.cs" />
    <Compile Include="tests/ui/SkillsPanelCaptureTest.cs" />
    <!-- Compile MC 3943 stage 2g follower roster (the live-loop composition
         partial the root's companion loop moved into + the roster runtime
         proof; modes roster_follow / roster_neg). -->
    <Compile Include="world/WorldDirector.Roster.cs" />
    <!-- Compile MC 10080: the WILD-side members of that partial split VERBATIM
         into their own file (offer pair, recruit join, wild spawn, interact
         scan, calm-window load seam) so both halves sit under the 400 ceiling. -->
    <Compile Include="world/WorldDirector.Roster.Wild.cs" />
    <Compile Include="ci_proofs/RosterIntegrationProof.cs" />
    <!-- Compile MC 10036 roster_follow leg: the full-arc stage machine moved
         VERBATIM out of the proof above into its partial-class half (moves
         only — class name, modes and dispatch unchanged). -->
    <Compile Include="ci_proofs/RosterIntegrationProof.Follow.cs" />
    <!-- Compile M08 combat-3d source files (C10 + C11, pure logic). -->
    <Compile Include="src/combat/CombatVec3.cs" />
    <Compile Include="src/combat/EnemyAI.cs" />
    <Compile Include="src/combat/CombatSystem.cs" />
    <Compile Include="src/combat/PlayerController.cs" />
    <!-- Compile M12 boss-ecosystem-adaptation (C15, pure logic). -->
    <Compile Include="src/ecosystem/EcosystemSpawner.cs" />
    <Compile Include="src/ecosystem/BossController.cs" />
    <!-- Compile M11 save-progression (C14): pure logic + the GodotSaveStore
         user:// seam (needs GodotSharp — engine project only). Required by
         ci_proofs/BridgeMvpProof.cs (marker 6 SAVE_ROUNDTRIP); fixes the
         CS0234 'LastAnimal.Save does not exist' build breaker (MC 1256.5). -->
    <Compile Include="src/save/GameState.cs" />
    <Compile Include="src/save/SaveSystem.cs" />
    <Compile Include="src/save/ZoneProgression.cs" />
    <Compile Include="src/save/GodotSaveStore.cs" />
    <!-- Compile M06 audio files (autoload + test script). -->
    <Compile Include="autoload/MusicManager.cs" />
    <Compile Include="autoload/SfxRouter.cs" />
    <Compile Include="autoload/GameLoop.cs" />
    <Compile Include="tests/AudioTest.cs" />
    <!-- Compile the Godot-specific files (autoload + test scripts). -->
    <Compile Include="autoload/EventBus.cs" />
    <Compile Include="autoload/FrameworkTypes.cs" />
    <Compile Include="autoload/IGameModule.cs" />
    <Compile Include="autoload/GameBootstrap.cs" />
    <Compile Include="PreflightScript.cs" />
    <Compile Include="Player.cs" />
    <Compile Include="world/FollowCamera.cs" />
    <Compile Include="world/EnemyActor.cs" />
    <Compile Include="world/CompanionFollowBody.cs" />
    <Compile Include="world/CompanionVisual.cs" />
    <Compile Include="world/ActorVisual.cs" />
    <Compile Include="world/WorldDirector.cs" />
    <Compile Include="world/SaveLoadController.cs" />
    <Compile Include="ci_proofs/MainCompositionProof.cs" />
    <Compile Include="ci_proofs/BridgeMvpProof.cs" />
    <Compile Include="ci_proofs/RuntimeIntegrationProof.cs" />
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Save.cs" />
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Interact.cs" />
    <Compile Include="ci_proofs/ZoneBossProof.cs" />
    <Compile Include="ci_proofs/P1FixProof.cs" />
    <Compile Include="tests/BootTest.cs" />
    <Compile Include="tests/EmpathySignalTest.cs" />
    <Compile Include="tests/companion/CompanionRenderTest.cs" />
    <Compile Include="tests/ui/UiRenderTest.cs" />
    <Compile Include="tests/ui/UiHarnessSelfTest.cs" />
    <!-- Compile MC 10121 Inc-3 S2: the juice-shake proof partial (mode
         JUICE_SHAKE, stage 96); the shake itself lives in world/
         FollowCamera.cs. Appended at the ItemGroup END so S1's Juice.cs
         hunk (inserted mid-list at MC 10098's block) merges cleanly. -->
    <Compile Include="ci_proofs/RuntimeIntegrationProof.Shake.cs" />
  </ItemGroup>

</Project>
