<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for the Last Animal M00 preflight (MC 839.2, gunilla, 2026-08-31).
  Lives in skeleton/ because that is the project root (res://) and therefore the
  directory `dotnet build` walks up from when it looks for a NuGet.Config.

  HISTORY: this config used to point NuGet at the pinned mono editor's local
  nupkgs feed (engine/Godot_v4.7.2-stable_mono_linux_x86_64/GodotSharp/Tools/nupkgs)
  as drift protection. REMOVED 2026-09-28 (MC 1405 follow-up): the hardcoded Linux
  engine path breaks restore on every other host OS — on Windows the mono editor
  does not ship that folder and NU1301 fails the build 5x. Drift protection is now
  carried entirely by the EXACT version pin in LastAnimalPreflight.csproj
  (Godot.NET.Sdk/4.7.2 — no wildcard), so nuget.org cannot float the SDK version;
  the pin is the guard, not the local feed.

  This config is host-portable: nuget.org only, no local paths.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
