<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for the animation bake pipeline (LastAnimalM09Bake).

  HISTORY: this config pointed NuGet at a retired seat's local engine feed
  (../../../../gunilla/engine/Godot_v4.7.2-stable_mono_linux_x86_64/GodotSharp/Tools/nupkgs).
  REMOVED 2026-09-28 (MC 1405 follow-up): the hardcoded Linux path breaks restore
  on every other host OS (on Windows the mono editor does not ship that folder and
  NU1301 fails the build), and the seat it referenced is retired. Drift protection
  is carried entirely by the EXACT version pin in LastAnimalM09Bake.csproj
  (Godot.NET.Sdk/4.7.2 — no wildcard), so nuget.org cannot float the SDK version;
  the pin is the guard, not the local feed.

  This config is host-portable: nuget.org only, no local paths.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
