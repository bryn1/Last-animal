# Build outputs — regenerated by ci/export_check.sh, never committed (181 MB per run)
skeleton/build/

# Godot editor cache — regenerated by --import / --build-solutions
skeleton/.godot/

# .NET build intermediates
**/obj/
**/bin/
*.user

# Vendored engine binary + export templates: 1.7 GB, pinned by checksum in
# engine/PIN.txt, restored via engine/PIN.txt install steps. Committing a 1.7 GB
# blob into a preflight repo would make the repo unusable to clone.
engine/Godot_v4.7.2-stable_mono_linux_x86_64/

# scratch / staging
.parts/
*.tmp
.tmp/
.audits/

# Import metadata for the vendored CC0 asset packs (Kenney): regenerated by
# `godot --headless --import`; packs are committed without it (df8ff23) and the
# CI gates import on demand. Keeps ~3.3k generated .import files out of the tree.
skeleton/resources/assets_packs/**/*.import

# Downloaded engine artifacts + extracted non-mono editor: restorable via
# engine/PIN.txt (checksums in SHA512-SUMS.txt / local.sha512 stay committed).
engine/*.zip
engine/*.tpz
engine/*.xz.sha256
engine/Godot_v4.7.2-stable_linux.x86_64
